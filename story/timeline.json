 ],
 "lines": [
  {
   "idx": 1,
   "speaker": "N",
   "start": 12.2,
   "dur": 15.052517,
   "text": "Deep underground, in a small dark bedroom, red emergency lights flicker. Eight-year-old Mia sleeps beneath an old blanket. On the nightstand beside her rests a framed photograph... of Mia and her mother."
  },
  {
   "idx": 2,
   "speaker": "N",
   "start": 28.402516999999996,
   "dur": 7.377732,
   "text": "ECHO-07 stands beside her bed, watching her quietly. Inside him, red warnings flash."
  },
  {
   "idx": 3,
   "speaker": "N",
   "start": 36.930248999999996,
   "dur": 2.273946,
   "text": "Mia slowly opens her eyes."
  },
  {
   "idx": 4,
   "speaker": "MIA",
   "start": 39.854195,
   "dur": 0.740385,
   "text": "Echo?"
  },
  {
   "idx": 5,
   "speaker": "ECHO",
   "start": 40.99458,
   "dur": 0.929138,
   "text": "Yes, Mia?"
  },
  {
   "idx": 6,
   "speaker": "MIA",
   "start": 42.323718,
   "dur": 2.011361,
   "text": "Is Mommy coming home tomorrow?"
  },
  {
   "idx": 7,
   "speaker": "N",
   "start": 45.485079,
   "dur": 6.899909,
   "text": "A new warning flashes inside him. Echo looks toward the photograph on the nightstand... and pauses."
  },
  {
   "idx": 8,
   "speaker": "ECHO",
   "start": 53.034988,
   "dur": 2.267687,
   "text": "Yes, Mia. Tomorrow."
  },
  {
   "idx": 9,
   "speaker": "N",
   "start": 56.452675,
   "dur": 2.758367,
   "text": "Mia smiles, and closes her eyes."
  },
  {
   "idx": 10,
   "speaker": "MIA",
   "start": 59.861042,
   "dur": 1.179252,
   "text": "Goodnight, Echo."
  },
  {
   "idx": 11,
   "speaker": "ECHO",
   "start": 61.440293999999994,
   "dur": 0.84941,
   "text": "Goodnight, Mia."
  },
  {
   "idx": 12,
   "speaker": "N",
   "start": 63.43970399999999,
   "dur": 3.556916,
   "text": "And Echo's cyan eyes dim... with sadness."
  },
  {
   "idx": 14,
   "speaker": "N",
   "start": 72.69662,
   "dur": 15.668481,
   "text": "Morning in the underground shelter. Echo stands at a small kitchen counter as smoke rises from the toaster. At the table, Mia watches... suspiciously. Echo proudly places a plate of burnt black toast in front of her."
  },
  {
   "idx": 15,
   "speaker": "MIA",
   "start": 89.515101,
   "dur": 1.916735,
   "text": "You burned it again."
  },
  {
   "idx": 16,
   "speaker": "ECHO",
   "start": 91.83183600000001,
   "dur": 3.418957,
   "text": "Incorrect. It is eighty-seven percent toasted."
  },
  {
   "idx": 17,
   "speaker": "MIA",
   "start": 95.65079300000002,
   "dur": 1.921451,
   "text": "It's BLACK!"
  },
  {
   "idx": 18,
   "speaker": "ECHO",
   "start": 97.97224400000003,
   "dur": 2.202245,
   "text": "A desirable shade of toast."
  },
  {
   "idx": 19,
   "speaker": "N",
   "start": 100.82448900000004,
   "dur": 5.400272,
   "text": "Mia bursts into laughter, while Echo examines the toast, looking confused."
  },
  {
   "idx": 20,
   "speaker": "ECHO",
   "start": 106.87476100000005,
   "dur": 1.956621,
   "text": "Would you prefer eighty-six percent?"
  },
  {
   "idx": 21,
   "speaker": "MIA",
   "start": 109.23138200000005,
   "dur": 2.264649,
   "text": "I'd prefer bread."
  },
  {
   "idx": 22,
   "speaker": "N",
   "start": 112.64603100000006,
   "dur": 8.098594,
   "text": "Echo tilts his head. Later, they play chess. When Echo looks away... Mia secretly moves one of his pieces."
  },
  {
   "idx": 23,
   "speaker": "ECHO",
   "start": 121.39462500000008,
   "dur": 1.124921,
   "text": "You are cheating."
  },
  {
   "idx": 24,
   "speaker": "MIA",
   "start": 122.91954600000008,
   "dur": 0.97381,
   "text": "Prove it."
  },
  {
   "idx": 25,
   "speaker": "N",
   "start": 125.04335600000009,
   "dur": 8.269252,
   "text": "Echo looks directly at the moved piece, his eyes narrowing... then he deliberately moves another piece, letting Mia win."
  },
  {
   "idx": 26,
   "speaker": "MIA",
   "start": 133.9626080000001,
   "dur": 0.93907,
   "text": "Checkmate!"
  },
  {
   "idx": 27,
   "speaker": "ECHO",
   "start": 135.3016780000001,
   "dur": 1.674444,
   "text": "An unexpected defeat."
  },
  {
   "idx": 28,
   "speaker": "N",
   "start": 138.1261220000001,
   "dur": 11.243333,
   "text": "Mia celebrates, and Echo's eyes curve into a smile. Afterward, Mia draws a crayon picture of herself, Echo, and her mother, holding hands beneath a bright sun."
  },
  {
   "idx": 29,
   "speaker": "MIA",
   "start": 150.0194550000001,
   "dur": 2.788798,
   "text": "When Mommy comes back, we'll all go outside together."
  },
  {
   "idx": 30,
   "speaker": "ECHO",
   "start": 153.2082530000001,
   "dur": 1.87907,
   "text": "That sounds... wonderful."
  },
  {
   "idx": 31,
   "speaker": "N",
   "start": 156.23732300000012,
   "dur": 2.485102,
   "text": "Mia tapes the drawing to Echo's chest."
  },
  {
   "idx": 32,
   "speaker": "MIA",
   "start": 159.37242500000013,
   "dur": 1.515238,
   "text": "Now we're a family."
  },
  {
   "idx": 33,
   "speaker": "N",
   "start": 162.03766300000015,
   "dur": 7.234172,
   "text": "Echo looks down at the drawing. His battery drops to ten percent... and he quietly covers the warning with his hand."
  },
  {
   "idx": 35,
   "speaker": "N",
   "start": 174.97183500000014,
   "dur": 11.018707,
   "text": "While Echo repairs equipment elsewhere, Mia explores a dim corridor with her flashlight. The beam reveals a large, locked metal door. Surface Access."
  },
  {
   "idx": 36,
   "speaker": "MIA",
   "start": 186.64054200000015,
   "dur": 1.253265,
   "text": "What's behind here?"
  },
  {
   "idx": 37,
   "speaker": "N",
   "start": 189.04380700000016,
   "dur": 7.372585,
   "text": "She touches the access panel. A red lock appears... and an alarm sounds. Echo rushes into the corridor."
  },
  {
   "idx": 38,
   "speaker": "ECHO",
   "start": 197.06639200000015,
   "dur": 2.004127,
   "text": "Mia! Step away from the door."
  },
  {
   "idx": 39,
   "speaker": "MIA",
   "start": 199.47051900000017,
   "dur": 1.598118,
   "text": "Why can't we go outside?"
  },
  {
   "idx": 40,
   "speaker": "ECHO",
   "start": 201.46863700000017,
   "dur": 1.548254,
   "text": "The surface is unsafe."
  },
  {
   "idx": 41,
   "speaker": "N",
   "start": 204.16689100000016,
   "dur": 2.667438,
   "text": "Mia looks at the door, then back at Echo."
  },
  {
   "idx": 42,
   "speaker": "MIA",
   "start": 207.48432900000017,
   "dur": 4.136168,
   "text": "But Mommy went outside. How many days has she been gone?"
  },
  {
   "idx": 43,
   "speaker": "N",
   "start": 212.77049700000018,
   "dur": 2.152948,
   "text": "Echo becomes completely still."
  },
  {
   "idx": 44,
   "speaker": "ECHO",
   "start": 215.5734450000002,
   "dur": 1.454036,
   "text": "You should return to your room."
  },
  {
   "idx": 45,
   "speaker": "MIA",
   "start": 217.9274810000002,
   "dur": 1.508957,
   "text": "Echo. How many?"
  },
  {
   "idx": 46,
   "speaker": "ECHO",
   "start": 220.33643800000021,
   "dur": 1.04805,
   "text": "I do not remember."
  },
  {
   "idx": 47,
   "speaker": "MIA",
   "start": 222.2844880000002,
   "dur": 1.901723,
   "text": "But you remember everything."
  },
  {
   "idx": 48,
   "speaker": "N",
   "start": 225.33621100000022,
   "dur": 5.06898,
   "text": "Disappointed, Mia walks away... leaving Echo alone beside the door."
  },
  {
   "idx": 50,
   "speaker": "N",
   "start": 236.10519100000022,
   "dur": 4.303084,
   "text": "That night, Mia wakes up... and Echo is gone."
  },
  {
   "idx": 51,
   "speaker": "MIA",
   "start": 241.05827500000024,
   "dur": 0.667664,
   "text": "Echo?"
  },
  {
   "idx": 52,
   "speaker": "N",
   "start": 242.87593900000024,
   "dur": 10.149864,
   "text": "She follows a faint mechanical sound into a dark maintenance room. Echo is kneeling beside a damaged charging station. Sparks fly from the cables."
  },
  {
   "idx": 53,
   "speaker": "ECHO",
   "start": 253.67580300000026,
   "dur": 3.482222,
   "text": "Attempt twenty-seven... unsuccessful."
  },
  {
   "idx": 54,
   "speaker": "N",
   "start": 258.3080250000002,
   "dur": 11.916009,
   "text": "Nearby, Mia notices an old computer terminal. On its screen... her mother's photograph. She presses play. Doctor Elena appears, in a flickering blue recording."
  },
  {
   "idx": 55,
   "speaker": "ELENA",
   "start": 271.37403400000017,
   "dur": 12.226168,
   "text": "Echo. If you're watching this, the evacuation has failed. Keep Mia safe. She's only three. She won't understand what's happening. If I don't return... promise me you won't let her lose hope."
  },
  {
   "idx": 56,
   "speaker": "ECHO",
   "start": 284.0002020000001,
   "dur": 0.789909,
   "text": "I promise."
  },
  {
   "idx": 57,
   "speaker": "N",
   "start": 285.9401110000001,
   "dur": 6.484921,
   "text": "The recording ends. Startled, Mia knocks a metal container to the floor. Echo turns around."
  },
  {
   "idx": 58,
   "speaker": "MIA",
   "start": 293.0750320000001,
   "dur": 4.998322,
   "text": "I was three? You've been telling me tomorrow for FIVE years?"
  },
  {
   "idx": 59,
   "speaker": "ECHO",
   "start": 298.47335400000003,
   "dur": 2.015896,
   "text": "Mia, I was trying to..."
  },
  {
   "idx": 60,
   "speaker": "MIA",
   "start": 300.88925,
   "dur": 2.012109,
   "text": "You lied to me!"
  },
  {
   "idx": 61,
   "speaker": "N",
   "start": 304.051359,
   "dur": 6.45941,
   "text": "Mia runs out of the room. Echo stays beside the broken charger... as his eyes dim."
  },
  {
   "idx": 63,
   "speaker": "N",
   "start": 316.21076899999997,
   "dur": 7.917324,
   "text": "Mia sits alone on her bed, hugging her red scarf. Echo approaches the closed door, carrying a small dinner tray."
  },
  {
   "idx": 64,
   "speaker": "ECHO",
   "start": 325.27809299999996,
   "dur": 4.417642,
   "text": "Mia. Your dinner is ready. I did not burn the toast."
  },
  {
   "idx": 65,
   "speaker": "MIA",
   "start": 330.59573499999993,
   "dur": 2.059161,
   "text": "Go away."
  },
  {
   "idx": 66,
   "speaker": "N",
   "start": 333.8048959999999,
   "dur": 4.284853,
   "text": "Echo slowly lowers the tray, and sits down against the closed door."
  },
  {
   "idx": 67,
   "speaker": "MIA",
   "start": 339.2397489999999,
   "dur": 1.986213,
   "text": "You said robots can't lie."
  },
  {
   "idx": 68,
   "speaker": "ECHO",
   "start": 342.1259619999999,
   "dur": 1.189569,
   "text": "We are not supposed to."
  },
  {
   "idx": 69,
   "speaker": "MIA",
   "start": 344.2155309999999,
   "dur": 1.303605,
   "text": "Then why did you?"
  },
  {
   "idx": 70,
   "speaker": "N",
   "start": 346.66913599999987,
   "dur": 1.486395,
   "text": "Echo looks at the floor."
  },
  {
   "idx": 71,
   "speaker": "ECHO",
   "start": 348.80553099999986,
   "dur": 6.338322,
   "text": "The first time I told you she would return... you stopped crying. I wanted you to smile again."
  },
  {
   "idx": 72,
   "speaker": "N",
   "start": 356.29385299999984,
   "dur": 3.557937,
   "text": "Inside the bedroom, Mia looks at her mother's photograph."
  },
  {
   "idx": 73,
   "speaker": "MIA",
   "start": 360.5017899999998,
   "dur": 1.630181,
   "text": "That doesn't make it okay."
  },
  {
   "idx": 74,
   "speaker": "ECHO",
   "start": 363.03197099999977,
   "dur": 1.67322,
   "text": "No. It does not."
  },
  {
   "idx": 75,
   "speaker": "MIA",
   "start": 365.60519099999976,
   "dur": 2.154558,
   "text": "I hate you."
  },
  {
   "idx": 76,
   "speaker": "ECHO",
   "start": 368.65974899999975,
   "dur": 0.672948,
   "text": "Understood."
  },
  {
   "idx": 77,
   "speaker": "N",
   "start": 370.48269699999975,
   "dur": 8.173855,
   "text": "He leaves the tray outside her door. Suddenly... the lights flicker. Echo looks toward the forbidden surface door."
  },
  {
   "idx": 79,
   "speaker": "N",
   "start": 384.35655199999974,
   "dur": 8.578209,
   "text": "The whole shelter loses power. Darkness... then the red emergency lights kick on. Mia wakes up, frightened."
  },
  {
   "idx": 80,
   "speaker": "MIA",
   "start": 393.58476099999973,
   "dur": 0.718458,
   "text": "Echo?"
  },
  {
   "idx": 81,
   "speaker": "N",
   "start": 395.4532189999997,
   "dur": 3.112245,
   "text": "Echo enters, holding her bright yellow raincoat."
  },
  {
   "idx": 82,
   "speaker": "ECHO",
   "start": 399.21546399999966,
   "dur": 1.005646,
   "text": "We have to leave."
  },
  {
   "idx": 83,
   "speaker": "MIA",
   "start": 400.62110999999965,
   "dur": 1.871542,
   "text": "Leave? Where?"
  },
  {
   "idx": 84,
   "speaker": "ECHO",
   "start": 402.8926519999996,
   "dur": 0.73517,
   "text": "Outside."
  },
  {
   "idx": 85,
   "speaker": "N",
   "start": 404.77782199999956,
   "dur": 11.432608,
   "text": "At the Surface Access door, Echo enters an emergency override code. The heavy door slowly grinds open... and warm golden sunlight floods the dark corridor."
  },
  {
   "idx": 86,
   "speaker": "N",
   "start": 417.36042999999955,
   "dur": 12.74746,
   "text": "Mia and Echo step out into a breathtaking, abandoned city... overgrown with green vines, blooming flowers and clear flowing streams. Birds soar across the bright sky."
  },
  {
   "idx": 87,
   "speaker": "MIA",
   "start": 431.2578899999995,
   "dur": 2.886893,
   "text": "Wow... You said it wasn't safe."
  },
  {
   "idx": 88,
   "speaker": "ECHO",
   "start": 434.5447829999995,
   "dur": 2.63424,
   "text": "The last surface readings were five years old."
  },
  {
   "idx": 89,
   "speaker": "MIA",
   "start": 437.57902299999944,
   "dur": 1.281224,
   "text": "You could've checked."
  },
  {
   "idx": 90,
   "speaker": "ECHO",
   "start": 439.2602469999994,
   "dur": 0.535215,
   "text": "Yes."
  },
  {
   "idx": 91,
   "speaker": "N",
   "start": 440.9454619999994,
   "dur": 4.82449,
   "text": "A colorful butterfly flutters down, and lands on Mia's outstretched hand."
  },
  {
   "idx": 92,
   "speaker": "MIA",
   "start": 446.4199519999994,
   "dur": 1.867166,
   "text": "I've never seen a real one."
  },
  {
   "idx": 93,
   "speaker": "N",
   "start": 449.4371179999994,
   "dur": 3.136961,
   "text": "Suddenly, Echo's sensors pick up a faint signal."
  },
  {
   "idx": 94,
   "speaker": "ECHO",
   "start": 453.22407899999934,
   "dur": 2.49576,
   "text": "Mia. There are other people."
  },
  {
   "idx": 95,
   "speaker": "MIA",
   "start": 456.11983899999933,
   "dur": 0.670839,
   "text": "Mommy?"
  },
  {
   "idx": 96,
   "speaker": "ECHO",
   "start": 457.1906779999993,
   "dur": 0.742358,
   "text": "I don't know."
  },
  {
   "idx": 97,
   "speaker": "N",
   "start": 459.0830359999993,
   "dur": 3.28941,
   "text": "Mia looks toward the distant radio tower on the horizon."
  },
  {
   "idx": 98,
   "speaker": "MIA",
   "start": 463.02244599999926,
   "dur": 1.266689,
   "text": "Then let's find out."
  },
  {
   "idx": 100,
   "speaker": "N",
   "start": 469.98913499999924,
   "dur": 8.00805,
   "text": "As they walk through the overgrown streets, Mia picks a small wildflower, and tucks it beside the crayon drawing on Echo's chest."
  },
  {
   "idx": 101,
   "speaker": "MIA",
   "start": 478.64718499999924,
   "dur": 1.534535,
   "text": "Now you look official."
  },
  {
   "idx": 102,
   "speaker": "ECHO",
   "start": 480.5817199999992,
   "dur": 1.543333,
   "text": "I was already official."
  },
  {
   "idx": 103,
   "speaker": "N",
   "start": 483.2750529999992,
   "dur": 9.068367,
   "text": "Mia smiles. By sunset, they reach an old ruined bridge leading toward the radio tower, its red beacon flashing in the distance."
  },
  {
   "idx": 104,
   "speaker": "N",
   "start": 493.4934199999992,
   "dur": 7.83254,
   "text": "Echo's steps grow slower. His damaged arm twitches... until his knees give way, and he collapses onto the bridge."
  },
  {
   "idx": 105,
   "speaker": "MIA",
   "start": 501.9759599999992,
   "dur": 0.72771,
   "text": "Echo!"
  },
  {
   "idx": 106,
   "speaker": "N",
   "start": 503.85366999999917,
   "dur": 2.963696,
   "text": "She kneels beside him as he struggles to get up."
  },
  {
   "idx": 107,
   "speaker": "ECHO",
   "start": 507.4673659999992,
   "dur": 2.523129,
   "text": "A temporary malfunction."
  },
  {
   "idx": 108,
   "speaker": "N",
   "start": 510.64049499999913,
   "dur": 2.588322,
   "text": "Mia sees the flashing light on his chest."
  },
  {
   "idx": 109,
   "speaker": "MIA",
   "start": 513.8788169999991,
   "dur": 2.060408,
   "text": "Stop lying!"
  },
  {
   "idx": 110,
   "speaker": "ECHO",
   "start": 516.3392249999991,
   "dur": 1.448367,
   "text": "My battery is depleted."
  },
  {
   "idx": 111,
   "speaker": "MIA",
   "start": 518.1875919999991,
   "dur": 1.568957,
   "text": "Then we'll find another one."
  },
  {
   "idx": 112,
   "speaker": "ECHO",
   "start": 520.156548999999,
   "dur": 3.749864,
   "text": "There is insufficient time. You must continue without me."
  },
  {
   "idx": 113,
   "speaker": "N",
   "start": 525.056412999999,
   "dur": 2.241814,
   "text": "Mia shakes her head, firmly."
  },
  {
   "idx": 114,
   "speaker": "MIA",
   "start": 527.948226999999,
   "dur": 0.623333,
   "text": "No."
  },
  {
   "idx": 115,
   "speaker": "ECHO",
   "start": 528.9715599999989,
   "dur": 0.501066,
   "text": "Mia..."
  },
  {
   "idx": 116,
   "speaker": "MIA",
   "start": 529.872625999999,
   "dur": 1.403061,
   "text": "You're my family too."
  },
  {
   "idx": 117,
   "speaker": "N",
   "start": 531.9256869999989,
   "dur": 4.772063,
   "text": "Mia holds out her hand. A soft smile appears in Echo's eyes."
  },
  {
   "idx": 118,
   "speaker": "ECHO",
   "start": 537.3477499999989,
   "dur": 2.058662,
   "text": "Then we will go together."
  },
  {
   "idx": 119,
   "speaker": "N",
   "start": 540.5564119999989,
   "dur": 7.053333,
   "text": "With her red scarf blowing in the sunset wind, Mia supports Echo's weight... as they cross the bridge together."
  },
  {
   "idx": 121,
   "speaker": "N",
   "start": 553.3097449999989,
   "dur": 9.615374,
   "text": "Night falls as they reach the abandoned radio station. Echo examines the emergency transmitter, pressing switches... but nothing turns on."
  },
  {
   "idx": 122,
   "speaker": "ECHO",
   "start": 563.5751189999988,
   "dur": 1.948889,
   "text": "The transmitter has no power."
  },
  {
   "idx": 123,
   "speaker": "N",
   "start": 566.6740079999988,
   "dur": 6.873515,
   "text": "Echo looks at the loose power cables... then down at his own chest. He picks up a heavy cable."
  },
  {
   "idx": 124,
   "speaker": "MIA",
   "start": 574.1975229999988,
   "dur": 1.579637,
   "text": "What are you doing?"
  },
  {
   "idx": 125,
   "speaker": "N",
   "start": 576.4271599999988,
   "dur": 3.128753,
   "text": "Echo plugs the cable directly into his chest."
  },
  {
   "idx": 126,
   "speaker": "ECHO",
   "start": 580.2059129999988,
   "dur": 2.63424,
   "text": "Mia. I need you to press that button."
  },
  {
   "idx": 127,
   "speaker": "N",
   "start": 583.4901529999987,
   "dur": 1.031791,
   "text": "She hesitates."
  },
  {
   "idx": 128,
   "speaker": "ECHO",
   "start": 585.1719439999987,
   "dur": 0.670703,
   "text": "Please."
  },
  {
   "idx": 129,
   "speaker": "N",
   "start": 586.9926469999987,
   "dur": 8.402971,
   "text": "Mia presses the button. Blue lights glow across the console. Static crackles from the speaker... and then, a voice."
  },
  {
   "idx": 130,
   "speaker": "OP",
   "start": 596.0456179999986,
   "dur": 2.61254,
   "text": "Hello? Is somebody there?"
  },
  {
   "idx": 131,
   "speaker": "N",
   "start": 599.8081579999986,
   "dur": 1.686122,
   "text": "Mia grabs the microphone."
  },
  {
   "idx": 132,
   "speaker": "MIA",
   "start": 602.1442799999985,
   "dur": 2.653492,
   "text": "Please help! My friend is dying!"
  },
  {
   "idx": 133,
   "speaker": "OP",
   "start": 605.1977719999985,
   "dur": 1.879433,
   "text": "Stay where you are. We're coming."
  },
  {
   "idx": 134,
   "speaker": "N",
   "start": 608.2272049999984,
   "dur": 1.466667,
   "text": "Mia turns to Echo."
  },
  {
   "idx": 135,
   "speaker": "MIA",
   "start": 610.3438719999984,
   "dur": 3.3122,
   "text": "They're coming! You heard them! They'll fix you."
  },
  {
   "idx": 136,
   "speaker": "N",
   "start": 614.3060719999984,
   "dur": 3.745011,
   "text": "Echo's eyes begin to flicker. Mia takes his hand."
  },
  {
   "idx": 137,
   "speaker": "MIA",
   "start": 618.7010829999983,
   "dur": 1.557506,
   "text": "Promise me you'll be okay."
  },
  {
   "idx": 138,
   "speaker": "N",
   "start": 621.4085889999983,
   "dur": 3.509002,
   "text": "Echo looks down at the crayon family drawing on his chest."
  },
  {
   "idx": 139,
   "speaker": "ECHO",
   "start": 625.5675909999983,
   "dur": 0.891905,
   "text": "I promise."
  },
  {
   "idx": 140,
   "speaker": "N",
   "start": 627.6094959999982,
   "dur": 5.647914,
   "text": "Echo's cyan eyes slowly dim to black. His hand goes still."
  },
  {
   "idx": 141,
   "speaker": "MIA",
   "start": 633.9074099999982,
   "dur": 2.371293,
   "text": "Echo? Echo!"
  },
  {
   "idx": 142,
   "speaker": "N",
   "start": 637.4287029999982,
   "dur": 7.003628,
   "text": "Mia wraps her arms around him... as the headlights of a distant rescue vehicle shine through the station windows."
  },
  {
   "idx": 144,
   "speaker": "N",
   "start": 650.1323309999983,
   "dur": 7.256009,
   "text": "Three weeks later, morning sunlight fills a peaceful settlement, surrounded by gardens and rebuilt homes."
  },
  {
   "idx": 145,
   "speaker": "N",
   "start": 658.5383399999982,
   "dur": 7.288798,
   "text": "Inside a warm wooden workshop, Mia waits anxiously beside Echo, as a technician connects a new power cell."
  },
  {
   "idx": 146,
   "speaker": "TECH",
   "start": 666.4771379999983,
   "dur": 1.358277,
   "text": "Let's see if this works."
  },
  {
   "idx": 147,
   "speaker": "N",
   "start": 668.9854149999983,
   "dur": 4.349274,
   "text": "Echo's systems hum to life. His cyan eyes light up."
  },
  {
   "idx": 148,
   "speaker": "MIA",
   "start": 673.9846889999983,
   "dur": 0.760816,
   "text": "Echo!"
  },
  {
   "idx": 149,
   "speaker": "ECHO",
   "start": 675.1455049999983,
   "dur": 3.768095,
   "text": "Hello. I am ECHO-07. How may I assist you?"
  },
  {
   "idx": 150,
   "speaker": "N",
   "start": 680.0635999999982,
   "dur": 7.464376,
   "text": "Mia's smile fades. Slowly, she takes out their worn crayon drawing, and places it into Echo's hands."
  },
  {
   "idx": 151,
   "speaker": "MIA",
   "start": 688.1779759999982,
   "dur": 2.283583,
   "text": "It's okay. We can start again."
  },
  {
   "idx": 152,
   "speaker": "N",
   "start": 691.6115589999982,
   "dur": 6.34127,
   "text": "She turns toward the door. Behind her, Echo looks down at the drawing... his eyes flickering."
  },
  {
   "idx": 153,
   "speaker": "ECHO",
   "start": 698.6028289999982,
   "dur": 0.425873,
   "text": "Mia?"
  },
  {
   "idx": 154,
   "speaker": "N",
   "start": 699.6787019999982,
   "dur": 3.172177,
   "text": "She freezes... and slowly turns around."
  },
  {
   "idx": 155,
   "speaker": "MIA",
   "start": 703.5008789999982,
   "dur": 1.737982,
   "text": "You remember me?"
  },
  {
   "idx": 156,
   "speaker": "ECHO",
   "start": 706.1388609999982,
   "dur": 3.473855,
   "text": "I remember... that you prefer your toast unburned."
  },
  {
   "idx": 157,
   "speaker": "N",
   "start": 710.7627159999981,
   "dur": 12.165261,
   "text": "Laughing through her tears, Mia runs to him and throws her arms around him. Echo gently holds her close, their family drawing in his hand... as warm morning sunlight fills the workshop."
  },
  {
   "idx": 158,
   "speaker": "N",
   "start": 723.5779769999981,
   "dur": 0.67542,
   "text": "The End."
  }
 ],
